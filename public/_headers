# Cloudflare Pages custom response headers.
# Vite copies this to the build output root on deploy.

# Fingerprinted build assets (content-hashed filenames) never change — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media. Filenames are NOT hashed, so use a moderate TTL rather than immutable;
# bump/rename the file (or purge) if a clip is ever replaced.
/videos/*
  Cache-Control: public, max-age=604800
